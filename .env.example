# All optional. Defaults run out of the box with a local SQLite ledger.
EDGEFEED_DB_URL=sqlite:///edgefeed.sqlite
EDGEFEED_PAIRS=config/pairs.yaml
EDGEFEED_INTERVAL=15
EDGEFEED_SPORTS=nba,nhl,nfl,mlb,ncaab,epl,laliga,seriea,ucl
EDGEFEED_SPORTS_DAYS_AHEAD=2

# record an opportunity once it clears both bars
EDGEFEED_MIN_EDGE_CENTS=0.25
EDGEFEED_MIN_PROFIT=1
# alert only when it is also worth the capital it locks
EDGEFEED_ALERT_MIN_APR=0.10
EDGEFEED_ALERT_MIN_PROFIT=5

# Telegram alerts (create a bot with @BotFather; the chat id is yours or a channel's)
EDGEFEED_TELEGRAM_BOT_TOKEN=
EDGEFEED_TELEGRAM_CHAT_ID=
EDGEFEED_LATENCY_ALERTS=0

EDGEFEED_METRICS_PORT=9108

# fast "hot" scans for games in play (from N minutes before start to N hours after) and open edges
EDGEFEED_HOT_INTERVAL=3
EDGEFEED_HOT_BEFORE_MINUTES=20
EDGEFEED_HOT_AFTER_HOURS=4

# yield on locked capital. Kalshi's interest on positions is for eligible US users only, so it is
# off by default; Polymarket pays holding rewards on markets flagged holdingRewardsEnabled.
EDGEFEED_KALSHI_APY=0
EDGEFEED_POLY_HOLDING_APY=0.04

# paper trading: re-fetch both books when an edge opens, "take" it at this size, settle later
EDGEFEED_PAPER=1
EDGEFEED_PAPER_CONTRACTS=200
EDGEFEED_PAPER_MAX_LOCK_DAYS=14
EDGEFEED_SETTLE_EVERY=300
